{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.automation"
  },
  "deploy": {
    "startCommand": "python -m scripts.run_official_x_daily",
    "cronSchedule": "*/15 23,0-2 * * *",
    "restartPolicyType": "NEVER"
  }
}
