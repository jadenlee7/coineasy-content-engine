    "dockerfilePath": "Dockerfile.grok-qa"
  },
  "deploy": {
    "startCommand": "python -m scripts.run_grok_qa_dispatch --run-once",
    "cronSchedule": "*/5 * * * *",
    "restartPolicyType": "NEVER"
  }
}
