{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.buzz-operations"
  },
  "deploy": {
    "preDeployCommand": "python -m scripts.run_origintrail_buzz_operations --validate-only",
    "startCommand": "python -m scripts.run_origintrail_buzz_operations --scan-once",
    "cronSchedule": "*/2 * * * *",
    "restartPolicyType": "NEVER"
  }
}
