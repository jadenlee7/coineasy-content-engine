FROM python:3.12-slim

WORKDIR /app

COPY requirements-automation.txt .
RUN pip install --no-cache-dir -r requirements-automation.txt

COPY core ./core
COPY clients ./clients
COPY scripts ./scripts

ENV PYTHONUNBUFFERED=1
ENV TELEGRAM_PUBLICATION_ENABLED=false
ENV TELEGRAM_PUBLICATION_ALLOWED_CLIENTS=squid

CMD ["python", "-m", "scripts.run_telegram_publications"]
