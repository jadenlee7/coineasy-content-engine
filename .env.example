# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# X (Twitter) API v2 bearer token (for daily news pipeline)
X_BEARER_TOKEN=

# Typefully Public API v2 (Bearer token, single key for whole workspace)
TYPEFULLY_API_KEY=

# API server secret (generate: openssl rand -hex 32)
API_SECRET=your-random-secret-here

# Optional per-client Railway API keys. A client key can access only its own
# generation/publishing routes and files; API_SECRET remains the admin key.
API_KEY_YELLOW=
API_KEY_ORIGINTRAIL=
API_KEY_SQUID=
API_KEY_BABYLON=

# Railway-local generated file retention. Defaults keep completed files for 24h,
# protect files younger than 30m, and cap exact edu_/news_ run folders at 2 GiB.
# Hard safety floors prevent accidental immediate deletion after a response.
# OUTPUT_RETENTION_TTL_HOURS=24
# OUTPUT_RETENTION_MAX_MIB=2048
# OUTPUT_RETENTION_MIN_AGE_MINUTES=30
# OUTPUT_RETENTION_ACTIVE_LEASE_MINUTES=120

# Netlify team console access code (server-side only; minimum 16 characters)
STUDIO_ACCESS_TOKEN=your-high-entropy-team-access-code
# Dedicated read-only credential shared only with @CoinEasy_KPI_bot.
# Do not reuse API_SECRET or STUDIO_ACCESS_TOKEN.
CONTENT_KPI_SYNC_TOKEN=your-new-random-secret-at-least-32-characters
# Dedicated read-only OriginTrail -> Buzz shadow adapter credential.
# The Buzz-side reader receives this token, never a Supabase or Studio key.
BUZZ_SHADOW_ACCESS_TOKEN=your-separate-buzz-shadow-token-at-least-32-characters
# Dedicated receipt-transition credential shared only by Netlify and the
# isolated OriginTrail Buzz worker. It must differ from every other token.
BUZZ_DELIVERY_WORKER_TOKEN=your-separate-buzz-delivery-token-at-least-32-characters
# Netlify-only, optional: scoped Postgres role JWTs for the two Buzz
# functions, minted with role coineasy_buzz_delivery (receipt transitions)
# and coineasy_batch_reviewer (read-only shadow list). When set they replace
# SUPABASE_SERVICE_ROLE_KEY for those functions only; unset keeps the shared
# key, and rollback is deleting the variable.
# SUPABASE_BUZZ_DELIVERY_KEY=
# SUPABASE_BUZZ_SHADOW_KEY=
# Dedicated review-decision credential shared only by Netlify and the isolated
# Buzz review scanner. Keep it distinct from every delivery/shadow/admin key.
BUZZ_REVIEW_WORKER_TOKEN=your-separate-buzz-review-token-at-least-32-characters
# Optional Netlify-only JWT for the coineasy_buzz_review_decider Postgres role.
# SUPABASE_BUZZ_REVIEW_KEY=
# Forward-only v2 cutoff shared exactly by Netlify and Railway. Choose it after
# the v2 deployment and before the first eligible staging delivery.
BUZZ_REVIEW_PROTOCOL_START_EPOCH=
# One to five lowercase 64-hex human reviewer public keys, shared by both
# planes. The Buzz service account public key must not be in this list.
BUZZ_REVIEWER_PUBKEYS=
# Netlify delivery materializer. Leave false outside one bounded staging run.
BUZZ_REVIEW_PACK_MATERIALIZATION_ENABLED=false
# Off by default; the production worker sets true. A live process
# additionally requires the explicit --send-once CLI flag.
BUZZ_DELIVERY_ENABLED=false
BUZZ_DELIVERY_ALLOWED_CLIENTS=origintrail
BUZZ_SHADOW_URL=https://coineasy-newscard.netlify.app/api/buzz-shadow/origintrail/batch
BUZZ_DELIVERY_URL=https://coineasy-newscard.netlify.app/api/buzz-delivery/origintrail
BUZZ_RELAY_URL=https://your-buzz-relay.example
BUZZ_PRIVATE_KEY=
# Optional NIP-OA owner attestation JSON.
BUZZ_AUTH_TAG=
BUZZ_CHANNEL_ID=00000000-0000-4000-8000-000000000000
BUZZ_CLI_PATH=/opt/coineasy/bin/buzz
BUZZ_DELIVERY_LEASE_SECONDS=180

# Isolated Railway Buzz review scanner. These have no usable defaults because
# every live scan is fenced to one environment and exact release SHA.
BUZZ_REVIEW_ENABLED=false
# Visible service replies require all three independent gates: this Railway
# send gate, the durable Railway outbox gate, and Netlify's outbox gate.
BUZZ_REVIEW_ACK_ENABLED=false
BUZZ_REVIEW_DURABLE_ACK_ENABLED=false
BUZZ_REVIEW_ACK_OUTBOX_ENABLED=false
BUZZ_REVIEW_ACK_LEASE_SECONDS=180
BUZZ_REVIEW_ALLOWED_CLIENTS=origintrail
BUZZ_REVIEW_URL=https://coineasy-newscard.netlify.app/api/buzz-review/origintrail
BUZZ_SERVICE_PUBKEY=
BUZZ_REVIEW_EXPECTED_ENVIRONMENT=staging
BUZZ_REVIEW_RELEASE_SHA=

# Review-only official X automation. Keep this separate from the human Studio
# access code. The cron may generate drafts but cannot approve or publish them.
STUDIO_AUTOMATION_TOKEN=your-separate-automation-secret-at-least-32-characters
STUDIO_BASE_URL=https://coineasy-newscard.netlify.app
AUTOMATION_TIMEZONE=Asia/Seoul
AUTOMATION_ALLOWED_CLIENTS=yellow,origintrail,squid,babylon
AUTOMATION_LOOKBACK_HOURS=30
AUTOMATION_DAILY_DRAFT_LIMIT=4
# Reserved for a later manual-review trigger; scheduled automation must keep this false.
AUTOMATION_ENABLE_TUTORIALS=false
# Optional EasyFarm aggregate editorial signals. Configure URL and token together.
# The URL is pinned to the dedicated EasyFarm Supabase Edge Function; do not use
# an operator key, Supabase service-role key, Telegram key, or browser credential.
# EASYFARM_CONTENT_SIGNALS_URL=https://jlxbywqofrltyttklcqy.supabase.co/functions/v1/content-signals-api
# EASYFARM_CONTENT_SIGNALS_TOKEN=your-dedicated-server-to-server-secret
# EASYFARM_CONTENT_SIGNALS_WINDOW_DAYS=7

# Review-only OpenAI Batch pilot. Defaults to dry_run and OriginTrail only.
# The Batch worker never receives publishing, outreach, or deploy credentials.
BATCH_EXPERIMENT_MODE=dry_run
BATCH_ALLOWED_CLIENTS=origintrail
BATCH_DAILY_CAP_USD=0.05
BATCH_MAX_CLAIMS=1
BATCH_MAX_REQUESTS_PER_BATCH=1
BATCH_TIMEZONE=Asia/Seoul
# Exact one-shot canary: 48 hours. Approved Production Shadow: exactly seven
# KST days with one exact $0.05-or-less provider Batch per KST day.
BATCH_EXPERIMENT_START_AT=
BATCH_EXPERIMENT_END_AT=
# Remains false unless the seven-day Production Shadow is explicitly approved.
BATCH_PRODUCTION_SHADOW_AUTO_DISPATCH=false
# Default-off activation. The config receipt binds the full seven-day scope;
# exact one-shot dispatch receipts still expire within two hours.
BATCH_CANARY_ENABLED=false
BATCH_CANARY_ENVIRONMENT=staging
# Railway injects this environment name; live startup requires it to be staging.
RAILWAY_ENVIRONMENT_NAME=
BATCH_CANARY_RELEASE_SHA=
# Railway injects this immutable build value; live startup requires an exact
# match with BATCH_CANARY_RELEASE_SHA. Do not override it manually.
RAILWAY_GIT_COMMIT_SHA=
BATCH_CANARY_APPROVAL_RECEIPT=
BATCH_CANARY_DISPATCH_RECEIPT=
# Dispatcher only. Do not place this on the Official X producer.
OPENAI_API_KEY=

# Content Studio durable history and private generated assets (server-side only)
# Apply every checked-in Supabase migration in timestamp order before enabling it.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
CONTENT_STUDIO_WORKSPACE_ID=00000000-0000-4000-8000-000000000000
# Netlify-only origin for authenticated Content Engine relays and publication kick.
RAILWAY_API_URL=https://your-content-engine.up.railway.app

# Per-client Telegram bot tokens + channel IDs (for publishing)
TELEGRAM_BOT_TOKEN_YELLOW=
TELEGRAM_CHANNEL_YELLOW=
TELEGRAM_BOT_TOKEN_SQUID=
TELEGRAM_CHANNEL_SQUID=

# Exact approved-version Telegram publisher. Both planes are disabled by
# default. Netlify uses the Studio flag to expose the queue action; Railway uses
# its own worker flag to claim jobs. Never enable the Studio flag before the
# Railway worker and database migration are ready.
STUDIO_TELEGRAM_PUBLISH_ENABLED=false
# Netlify-only first-slice gate. Only the exact value `squid` is accepted;
# adding another client requires coordinated Netlify, worker, and DB changes.
STUDIO_TELEGRAM_PUBLISH_ALLOWED_CLIENTS=squid
# Railway-only execution flag. The publication
# worker accepts only durable Daily News versions and sends the stored PNG plus
# exact stored Telegram caption once; it never retries after delivery begins.
TELEGRAM_PUBLICATION_ENABLED=false
TELEGRAM_PUBLICATION_ALLOWED_CLIENTS=squid
TELEGRAM_PUBLICATION_LEASE_SECONDS=180
TELEGRAM_PUBLICATION_MAX_CLAIMS=1
# Bounded service-role lease reconciliation batch used by --recovery-only.
TELEGRAM_PUBLICATION_RECOVERY_LIMIT=100
# Dedicated trigger secret shared only by Netlify and the main Railway API.
# The separate cron service does not need this incoming-request credential.
# Do not reuse API_SECRET, STUDIO_ACCESS_TOKEN, SUPABASE_SERVICE_ROLE_KEY, or
# any Telegram bot token.
PUBLICATION_WORKER_TOKEN=your-separate-publication-worker-secret-at-least-32-characters

# Model selection (optional). Central default if unset: claude-opus-4-8
# Override per-client in clients/<id>/config.yaml under llm.<pipeline>.model
# LLM_MODEL=claude-opus-4-8
# Stable image discovery/geometry QA; total visual calls are capped and time-budgeted.
# Override only with a temperature-capable model after visual placement tests.
# VISUAL_PLACEMENT_AUDIT_MODEL=claude-sonnet-4-5-20250929

# Render settings (optional)
# RENDER_TIMEOUT_MS=30000

# Logging (optional)
# LOG_LEVEL=INFO
