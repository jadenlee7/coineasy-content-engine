# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# X (Twitter) API v2 bearer token (for daily news pipeline)
X_BEARER_TOKEN=

# Typefully Public API v2 (Bearer token, single key for whole workspace)
TYPEFULLY_API_KEY=

# API server secret (generate: openssl rand -hex 32)
API_SECRET=your-random-secret-here

# Per-client Telegram bot tokens + channel IDs (for publishing)
TELEGRAM_BOT_TOKEN_YELLOW=
TELEGRAM_CHANNEL_YELLOW=
TELEGRAM_BOT_TOKEN_SQUID=
TELEGRAM_CHANNEL_SQUID=

# Model selection (optional). Central default if unset: claude-opus-4-8
# Override per-client in clients/<id>/config.yaml under llm.<pipeline>.model
# LLM_MODEL=claude-opus-4-8

# Render settings (optional)
# RENDER_TIMEOUT_MS=30000

# Logging (optional)
# LOG_LEVEL=INFO
