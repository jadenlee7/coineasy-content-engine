# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# X (Twitter) API v2 bearer token (for daily news pipeline)
X_BEARER_TOKEN=

# API server secret (generate: openssl rand -hex 32)
API_SECRET=your-random-secret-here

# Per-client Telegram bot tokens (optional, for publishing)
TELEGRAM_BOT_TOKEN_YELLOW=
TELEGRAM_BOT_TOKEN_SQUID=

# Model tuning (optional, has defaults)
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Render settings (optional)
# RENDER_TIMEOUT_MS=30000

# Logging (optional)
# LOG_LEVEL=INFO
