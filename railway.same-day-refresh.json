{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.same-day-refresh"
  },
  "deploy": {
    "preDeployCommand": "python -m scripts.run_official_x_same_day_refresh --validate-runtime-only",
    "startCommand": "python -m scripts.run_official_x_same_day_refresh --validate-runtime-only",
    "restartPolicyType": "NEVER"
  }
}
