FROM node:24.11.1-slim@sha256:48abc13a19400ca3985071e287bd405a1d99306770eb81d61202fb6b65cf0b57

WORKDIR /app
# Explicit minimal copy list: no Netlify, API, workers, provider code, dotenv,
# credentials, browser profiles, or production configuration enters this image.
COPY tools/managed-telegram-inspect/*.mjs ./tools/managed-telegram-inspect/
COPY scripts/lib/telegram-resolution-inspect.mjs ./scripts/lib/telegram-resolution-inspect.mjs

ARG RAILWAY_GIT_COMMIT_SHA
RUN node --input-type=module -e 'import { writeFileSync } from "node:fs"; const sha = process.env.RAILWAY_GIT_COMMIT_SHA; if (!/^[a-f0-9]{40}$/.test(sha || "")) process.exit(2); writeFileSync("tools/managed-telegram-inspect/build-sha.txt", sha + "\n", { mode: 0o444 });'

ENV NODE_ENV=production \
    MANAGED_INSPECT_ENABLED=false \
    MANAGED_INSPECT_BIND_HOST=0.0.0.0 \
    PORT=8787
USER node
EXPOSE 8787
CMD ["node", "tools/managed-telegram-inspect/server.mjs"]
