{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.buzz-delivery"
  },
  "deploy": {
    "startCommand": "python -m scripts.run_origintrail_buzz_delivery --send-once",
    "cronSchedule": "15 * * * *",
    "restartPolicyType": "NEVER"
  }
}
